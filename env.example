# Server
LISTEN_URL=0.0.0.0:8080
# Optional: serve built frontend (e.g. Docker sets FRONTEND_DIST=/app/frontend/dist)
# FRONTEND_DIST=/app/frontend/dist

# Firefly III (required for sync/push)
# FIREFLY_BASE_URL=https://firefly.example.com
# FIREFLY_TOKEN=your_personal_access_token

# Encryption key for SimpleFIN Access URL storage (base64 or hex, 32 bytes recommended)
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

# SimpleFIN client (optional)
# SIMPLEFIN_TIMEOUT_SECONDS=30
# SIMPLEFIN_VERIFY_TLS=true
# SIMPLEFIN_BRIDGE_URL=https://bridge.simplefin.org

# Database (optional; default: backend/data/firesimplefin.db)
# DATABASE_PATH=/path/to/firesimplefin.db

# Copy this file to .env and fill in real values.
# Do not commit .env, .env.enc, age keys, or any file containing real tokens.
